------- FILE arctang.asm LEVEL 2 PASS 2
      0  ce12					      include	"arctang.asm"
      1  ce12							; quadrants
      2  ce12							;
      3  ce12							;  0 | 1
      4  ce12							;  --+--
      5  ce12							;  2 | 3
      6  ce12
      7  ce12							; 24 angular regions total (0-23)
      8  ce12							; 6 regions per quadrant
      9  ce12							;  direction
     10  ce12							; 12 o'clock  6
     11  ce12							;  3 o'clock  0
     12  ce12							;  6 o'clock  18
     13  ce12							;  9 o'clock  12
     14  ce12
     15  ce12				   enemy_get_direction_of_player
     16  ce12							; references these zp vars
     17  ce12							;	collision_0_x
     18  ce12							;	collision_0_y
     19  ce12							;	player_x_hi
     20  ce12							;	player_y_hi
     21  ce12							; uses these zp vars
     22  ce12							;	collision_0_w	= x delta
     23  ce12							;	collision_0_h	= y delta
     24  ce12							;	collision_1_x	= "small"
     25  ce12							;	collision_1_y	= "large"
     26  ce12							;	collision_1_h	= "half"
     27  ce12							;	temp00 		= quadrant
     28  ce12							;	temp01 		= region
     29  ce12							;	temp02		= x register stash
     30  ce12							;	temp03		= y register stash
     31  ce12							; returns a = direction (or region)
     32  ce12		       86 88		      stx	temp02
     33  ce14		       84 89		      sty	temp03
     34  ce16							; find quadrant
     35  ce16		       a9 00		      lda	#0
     36  ce18		       85 86		      sta	temp00
     37  ce1a							; y quadrants
     38  ce1a		       a5 15		      lda	player_y_hi
     39  ce1c		       38		      sec
     40  ce1d		       e5 3c		      sbc	collision_0_y
     41  ce1f		       90 07		      bcc	.top_quadrant
