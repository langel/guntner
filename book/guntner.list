     47  d6ba				   phase_check_next_phase subroutine
     48  d6ba							; if phase_state == 0 then
     49  d6ba							; we don't know the kill count yet
     50  d6ba		       a5 59		      lda	phase_state
     51  d6bc		       f0 06		      beq	.not_next_phase
     52  d6be							; kill_counter > 0 means we need more killing
     53  d6be		       a5 5c		      lda	phase_kill_counter
     54  d6c0		       30 03		      bmi	.end_of_current_phase
     55  d6c2		       f0 01		      beq	.end_of_current_phase
     56  d6c4				   .not_next_phase
     57  d6c4		       60		      rts
     58  d6c5				   .end_of_current_phase
     59  d6c5							; use phase_state as a timer
     60  d6c5		       e6 59		      inc	phase_state
     61  d6c7							; transition time
     62  d6c7		       a5 59		      lda	phase_state
     63  d6c9		       c9 20		      cmp	#$20
     64  d6cb		       d0 06		      bne	.dont_crossbones
     65  d6cd		       20 10 d7 	      jsr	phase_clear_1_sprite_spawns
     66  d6d0		       20 04 f9 	      jsr	sfx_enemy_death
     67  d6d3				   .dont_crossbones
     68  d6d3		       a5 59		      lda	phase_state
     69  d6d5							; wait ~60 frames before trigger next phase sfx
     70  d6d5		       c9 40		      cmp	#$40
     71  d6d7		       d0 03		      bne	.dont_trigger_sfx
     72  d6d9		       20 ae fa 	      jsr	sfx_phase_next
     73  d6dc				   .dont_trigger_sfx
     74  d6dc		       a5 59		      lda	phase_state
     75  d6de							; wait ~64 frames before starting next phase
     76  d6de							; this should be synced with sfx 2nd chime
     77  d6de		       c9 44		      cmp	#$44
     78  d6e0		       d0 e2		      bne	.not_next_phase
     79  d6e2							; next phase process
