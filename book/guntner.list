------- FILE nesdefs.dasm LEVEL 2 PASS 2
      0  12000 ????				       include	"nesdefs.dasm"
      1  12000 ????
      2  12000 ????				       processor	6502
      3  12000 ????
      4  12000 ????						;;;;; CONSTANTS
      5  12000 ????
      6  12000 ????
      7  12000 ????		20 00	    PPU_CTRL   =	$2000
      8  12000 ????		20 01	    PPU_MASK   =	$2001
      9  12000 ????		20 02	    PPU_STATUS =	$2002
     10  12000 ????		20 03	    OAM_ADDR   =	$2003
     11  12000 ????		20 04	    OAM_DATA   =	$2004
     12  12000 ????		20 05	    PPU_SCROLL =	$2005
     13  12000 ????		20 06	    PPU_ADDR   =	$2006
     14  12000 ????		20 07	    PPU_DATA   =	$2007
     15  12000 ????
     16  12000 ????		40 14	    PPU_OAM_DMA =	$4014
     17  12000 ????
     18  12000 ????		40 16	    JOYPAD1    =	$4016
     19  12000 ????		40 17	    JOYPAD2    =	$4017
     20  12000 ????		00 80	    BUTTON_A   =	1 << 7
     21  12000 ????		00 40	    BUTTON_B   =	1 << 6
     22  12000 ????		00 20	    BUTTON_SELECT =	1 << 5
     23  12000 ????		00 10	    BUTTON_START =	1 << 4
     24  12000 ????		00 08	    BUTTON_UP  =	1 << 3
     25  12000 ????		00 04	    BUTTON_DOWN =	1 << 2
     26  12000 ????		00 02	    BUTTON_LEFT =	1 << 1
     27  12000 ????		00 01	    BUTTON_RIGHT =	1 << 0
     28  12000 ????
     29  12000 ????						; NOTE: I've put this outside of the PPU & APU, because it is a feature
     30  12000 ????						; of the APU that is primarily of use to the PPU.
     31  12000 ????		40 14	    OAM_DMA    =	$4014
     32  12000 ????						; OAM local RAM copy goes from $0200-$02FF:
     33  12000 ????		02 00	    OAM_RAM    =	$0200
     34  12000 ????
     35  12000 ????						; PPU_CTRL flags
     36  12000 ????			    CTRL_NMI   EQM	%10000000	; Execute Non-Maskable Interrupt on VBlank
     37  12000 ????			    CTRL_8x8   EQM	%00000000	; Use 8x8 Sprites
     38  12000 ????			    CTRL_8x16  EQM	%00100000	; Use 8x16 Sprites
     39  12000 ????			    CTRL_BG_0000 EQM	%00000000	; Background Pattern Table at $0000 in VRAM
     40  12000 ????			    CTRL_BG_1000 EQM	%00010000	; Background Pattern Table at $1000 in VRAM
     41  12000 ????			    CTRL_SPR_0000 EQM	%00000000	; Sprite Pattern Table at $0000 in VRAM
     42  12000 ????			    CTRL_SPR_1000 EQM	%00001000	; Sprite Pattern Table at $1000 in VRAM
     43  12000 ????			    CTRL_INC_1 EQM	%00000000	; Increment PPU Address by 1 (Horizontal rendering)
     44  12000 ????			    CTRL_INC_32 EQM	%00000100	; Increment PPU Address by 32 (Vertical rendering)
     45  12000 ????			    CTRL_NT_2000 EQM	%00000000	; Name Table Address at $2000
     46  12000 ????			    CTRL_NT_2400 EQM	%00000001	; Name Table Address at $2400
     47  12000 ????			    CTRL_NT_2800 EQM	%00000010	; Name Table Address at $2800
     48  12000 ????			    CTRL_NT_2C00 EQM	%00000011	; Name Table Address at $2C00
     49  12000 ????
     50  12000 ????						; PPU_MASK flags
     51  12000 ????			    MASK_TINT_RED EQM	%00100000	; Red Background
     52  12000 ????			    MASK_TINT_BLUE EQM	%01000000	; Blue Background
     53  12000 ????			    MASK_TINT_GREEN EQM	%10000000	; Green Background
     54  12000 ????			    MASK_SPR   EQM	%00010000	; Sprites Visible
     55  12000 ????			    MASK_BG    EQM	%00001000	; Backgrounds Visible
     56  12000 ????			    MASK_SPR_CLIP EQM	%00000100	; Sprites clipped on left column
     57  12000 ????			    MASK_BG_CLIP EQM	%00000010	; Background clipped on left column
     58  12000 ????			    MASK_COLOR EQM	%00000000	; Display in Color
     59  12000 ????			    MASK_MONO  EQM	%00000001	; Display in Monochrome
     60  12000 ????
     61  12000 ????						; read flags
     62  12000 ????			    F_BLANK    EQM	%10000000	; VBlank Active
     63  12000 ????			    F_SPRITE0  EQM	%01000000	; VBlank hit Sprite 0
     64  12000 ????			    F_SCAN8    EQM	%00100000	; More than 8 sprites on current scanline
     65  12000 ????			    F_WIGNORE  EQM	%00010000	; VRAM Writes currently ignored.
     66  12000 ????
     67  12000 ????
     68  12000 ????						;;;;; CARTRIDGE FILE HEADER
     69  12000 ????
     70  12000 ????			    NES_MIRR_HORIZ EQM	0
     71  12000 ????			    NES_MIRR_VERT EQM	1
     72  12000 ????			    NES_MIRR_QUAD EQM	8
     73  12000 ????
     74  12000 ????				       MAC	nes_header
     75  12000 ????				       seg	Header
     76  12000 ????				       org	$Bff0
     77  12000 ????			    .NES_MAPPER SET	{1}	;mapper number
     78  12000 ????			    .NES_PRG_BANKS SET	{2}	;number of 16K PRG banks, change to 2 for NROM256
     79  12000 ????			    .NES_CHR_BANKS SET	{3}	;number of 8K CHR banks (0 = RAM)
     80  12000 ????			    .NES_MIRRORING SET	{4}	;0 horizontal, 1 vertical, 8 four screen
     81  12000 ????				       byte	$4e,$45,$53,$1a	; header
     82  12000 ????				       byte	.NES_PRG_BANKS
     83  12000 ????				       byte	.NES_CHR_BANKS
     84  12000 ????				       byte	.NES_MIRRORING|(.NES_MAPPER<<4)
     85  12000 ????				       byte	.NES_MAPPER&$f0
     86  12000 ????				       byte	0,0,0,0,0,0,0,0	; reserved, set to zero
     87  12000 ????				       seg	Code
     88  12000 ????				       org	$C000
     89  12000 ????				       ENDM
     90  12000 ????
     91  12000 ????						;;;;; NES_INIT SETUP MACRO (place at start)
     92  12000 ????
     93  12000 ????				       MAC	nes_init
     94  12000 ????				       sei		;disable IRQs
     95  12000 ????				       cld		;decimal mode not supported
     96  12000 ????				       ldx	#$ff
     97  12000 ????				       txs		;set up stack pointer
     98  12000 ????				       inx		;increment X to 0
     99  12000 ????				       stx	PPU_MASK	;disable rendering
    100  12000 ????				       stx	DMC_FREQ	;disable DMC interrupts
    101  12000 ????				       stx	PPU_CTRL	;disable NMI interrupts
    102  12000 ????				       bit	PPU_STATUS	;clear VBL flag
    103  12000 ????				       bit	APU_CHAN_CTRL	;ack DMC IRQ bit 7
    104  12000 ????				       lda	#$40
    105  12000 ????				       sta	APU_FRAME	;disable APU Frame IRQ
    106  12000 ????				       lda	#$0F
    107  12000 ????				       sta	APU_CHAN_CTRL	;disable DMC, enable/init other channels.
    108  12000 ????				       ENDM
    109  12000 ????
    110  12000 ????						;;;;; NES_VECTORS - CPU vectors at end of address space
    111  12000 ????
    112  12000 ????				       MAC	nes_vectors
    113  12000 ????				       seg	Vectors	; segment "Vectors"
    114  12000 ????				       org	$fffa	; start at address $fffa
    115  12000 ????				       .word	NMIHandler	; $fffa vblank nmi
    116  12000 ????				       .word	Start	; $fffc reset
    117  12000 ????				       .word	NMIHandler	; $fffe irq / brk
    118  12000 ????				       ENDM
    119  12000 ????
    120  12000 ????						;;;;; PPU_SETADDR <address> - set 16-bit PPU address
    121  12000 ????
    122  12000 ????				       MAC	ppu_setaddr
    123  12000 ????				       lda	#>{1}	; upper byte
    124  12000 ????				       sta	PPU_ADDR
    125  12000 ????				       lda	#<{1}	; lower byte
    126  12000 ????				       sta	PPU_ADDR
    127  12000 ????				       ENDM
    128  12000 ????
    129  12000 ????						;;;;; PPU_SETVALUE <value> - feed 8-bit value to PPU
    130  12000 ????
    131  12000 ????				       MAC	ppu_setvalue
    132  12000 ????				       lda	#{1}
    133  12000 ????				       sta	PPU_DATA
    134  12000 ????				       ENDM
    135  12000 ????
    136  12000 ????						;;;;; SAVE_REGS - save A/X/Y registers
    137  12000 ????
    138  12000 ????				       MAC	save_regs
    139  12000 ????				       pha
    140  12000 ????				       txa
    141  12000 ????				       pha
    142  12000 ????				       tya
    143  12000 ????				       pha
    144  12000 ????				       ENDM
    145  12000 ????
    146  12000 ????						;;;;; RESTORE_REGS - restore Y/X/A registers
    147  12000 ????
    148  12000 ????				       MAC	restore_regs
    149  12000 ????				       pla
    150  12000 ????				       tay
    151  12000 ????				       pla
    152  12000 ????				       tax
    153  12000 ????				       pla
    154  12000 ????				       ENDM
    155  12000 ????
    156  12000 ????
