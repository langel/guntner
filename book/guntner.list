      3  d644
      4  d644				   timer_update subroutine
      5  d644							; UPDATE TIMER DIGITS
      6  d644							; but not if game is over
      7  d644		       a5 63		      lda	phase_end_game
      8  d646		       d0 4c		      bne	.timer_done
      9  d648							; frames 1s
     10  d648		       e6 44		      inc	timer_frames_1s
     11  d64a		       a9 6a		      lda	#char_set_offset+$a
     12  d64c		       c5 44		      cmp	timer_frames_1s
     13  d64e		       d0 44		      bne	.timer_done
     14  d650		       a9 60		      lda	#char_set_offset
     15  d652		       85 44		      sta	timer_frames_1s
     16  d654							; frames 10s
     17  d654		       e6 45		      inc	timer_frames_10s
     18  d656		       a9 66		      lda	#char_set_offset+$6
     19  d658		       c5 45		      cmp	timer_frames_10s
     20  d65a		       d0 38		      bne	.timer_done
     21  d65c		       a9 60		      lda	#char_set_offset
     22  d65e		       85 45		      sta	timer_frames_10s
     23  d660							; seconds 1s
     24  d660		       e6 46		      inc	timer_seconds_1s
     25  d662		       a9 6a		      lda	#char_set_offset+$a
     26  d664		       c5 46		      cmp	timer_seconds_1s
     27  d666		       d0 2c		      bne	.timer_done
     28  d668		       a9 60		      lda	#char_set_offset
     29  d66a		       85 46		      sta	timer_seconds_1s
     30  d66c							; seconds 10s
     31  d66c		       e6 47		      inc	timer_seconds_10s
     32  d66e		       a9 66		      lda	#char_set_offset+$6
     33  d670		       c5 47		      cmp	timer_seconds_10s
     34  d672		       d0 20		      bne	.timer_done
     35  d674		       a9 60		      lda	#char_set_offset
     36  d676		       85 47		      sta	timer_seconds_10s
     37  d678							; minutes 1s
     38  d678		       e6 48		      inc	timer_minutes_1s
     39  d67a		       a9 6a		      lda	#char_set_offset+$a
     40  d67c		       c5 48		      cmp	timer_minutes_1s
     41  d67e		       d0 14		      bne	.timer_done
     42  d680		       a9 60		      lda	#char_set_offset
     43  d682		       85 48		      sta	timer_minutes_1s
     44  d684							; minutes 10s
     45  d684							; we really checking this?
     46  d684							; let it go into tile limbo
     47  d684							; GAME OVER at 99:59.59 !!
     48  d684		       e6 49		      inc	timer_minutes_10s
     49  d686		       a5 47		      lda	timer_seconds_10s
     50  d688		       c9 6a		      cmp	#char_set_offset+$a
     51  d68a		       d0 08		      bne	.timer_done
     52  d68c		       a9 00		      lda	#$00
     53  d68e		       85 0b		      sta	player_health
     54  d690		       a9 01		      lda	#$01
     55  d692		       85 0c		      sta	player_lives
     56  d694				   .timer_done
     57  d694		       60		      rts
