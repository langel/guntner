      0  cf35					      include	"collision_detection.dasm"
      1  cf35
      2  cf35							;;;; COLLISION DETECTOR
      3  cf35							;
      4  cf35							;	works by putting object data into the following 0 page variables
      5  cf35							;
      6  cf35							;	collision_0_x	byte
      7  cf35							;	collision_0_y	byte
      8  cf35							;	collision_0_w	byte
      9  cf35							;	collision_0_h	byte
     10  cf35							;	collision_1_x	byte
     11  cf35							;	collision_1_y	byte
     12  cf35							;	collision_1_w	byte
     13  cf35							;	collision_1_h	byte
     14  cf35							;
     15  cf35							;	returns ff (true) or 00 (false) in accumulator
     16  cf35
     17  cf35							; the detect_collision subroutine was moved to player_bullets.asm
     18  cf35							; saving over 12 cycles per usage
     19  cf35
     20  cf35
     21  cf35
     22  cf35				   player_collision_detect subroutine
     23  cf35							; returns true/false in a
     24  cf35		       a5 53		      lda	state_iframes
     25  cf37		       d0 29		      bne	.no_collision
     26  cf39		       18		      clc
     27  cf3a		       a5 3b		      lda	collision_0_x
     28  cf3c		       65 3d		      adc	collision_0_w
     29  cf3e		       b0 22		      bcs	.no_collision	; make sure x+w is not less than x
     30  cf40		       c5 13		      cmp	player_x_hi
     31  cf42		       90 1e		      bcc	.no_collision
     32  cf44		       18		      clc
     33  cf45		       a5 17		      lda	player_coll_x
     34  cf47		       69 0b		      adc	#$0b	; player width
     35  cf49		       c5 3b		      cmp	collision_0_x
     36  cf4b		       90 15		      bcc	.no_collision
     37  cf4d		       18		      clc
     38  cf4e		       a5 3c		      lda	collision_0_y
     39  cf50		       65 3e		      adc	collision_0_h
     40  cf52		       c5 18		      cmp	player_coll_y
     41  cf54		       90 0c		      bcc	.no_collision
     42  cf56		       18		      clc
     43  cf57		       a5 18		      lda	player_coll_y
     44  cf59		       69 03		      adc	#$03	; player height
     45  cf5b		       c5 3c		      cmp	collision_0_y
     46  cf5d		       90 03		      bcc	.no_collision
     47  cf5f				   .collision
     48  cf5f		       a9 ff		      lda	#$ff
     49  cf61		       60		      rts
     50  cf62				   .no_collision
     51  cf62		       a9 00		      lda	#$00
     52  cf64		       60		      rts
